<!--
  Honda CBR500R (2015) — MJCF v0.1
  motosim project — open-source motorcycle autonomy research

  Topology: Whipple bicycle (Meijaard, Papadopoulos, Ruina, Schwab, 2007)
    - rear_frame : chassis + engine + fuel tank (root body, freejoint to world)
    - rear_wheel : child of rear_frame, hinge about y-axis
    - front_frame : child of rear_frame, hinge about tilted steer axis (rake)
    - front_wheel : child of front_frame, hinge about y-axis (after rake tilt)

  Scope of v0.1:
    - Rigid fork and swingarm (NO suspension)
    - NO rider mass (autonomous use case, 194 kg wet weight only)
    - NO actuators (passive validation only)
    - Cylinder wheels with elliptic friction (NO Pacejka tire model)
    - Manually-specified inertia tensors (NOT auto-computed from mesh)

  Validation gate for v0.1:
    Set qvel[rear_spin] = 16 rad/s (approx 5 m/s forward)
    Apply small initial lean (0.05 rad)
    Expected: bike self-stabilizes within 2 seconds, holds speed > 30 seconds
    If it falls: inertia tensors need tuning (not the topology)

  Reference parameters (2015 Honda CBR500R, verified from Honda spec sheet):
    wheelbase = 1.410 m
    rake angle = 25 deg = 0.436 rad
    trail = 0.102 m
    wet weight = 194 kg (includes 10 kg fuel, no rider)
    seat height = 0.785 m
    front tire: 120/70 ZR17 (outer radius 0.306 m, width 0.12 m)
    rear tire: 160/60 ZR17 (outer radius 0.312 m, width 0.16 m)

  Body frame convention: x = forward, y = left, z = up.
  Rear wheel contact at approx world origin at rest.
-->

<mujoco model="cbr500r_v01">

  <compiler angle="radian" coordinate="local" inertiafromgeom="false"/>

  <!-- No <flag energy="enable"/> — MJX (used by train.py / rollout.py) does not
       implement that flag. If you want energy telemetry in a native-MuJoCo-only
       script, add the flag at that call site via mj_model.opt.enableflags. -->
  <option timestep="0.002" integrator="RK4" iterations="100" tolerance="1e-10"/>

  <size nconmax="100" njmax="500"/>

  <visual>
    <quality shadowsize="4096" offsamples="4"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <map force="0.1" zfar="30"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <!-- condim=4 gives the solver tangential + torsional friction, important for wheels -->
    <geom contype="1" conaffinity="1" condim="4" friction="1.5 0.05 0.001" solref="0.005 1"/>
    <joint damping="0.01" armature="0.0" limited="false"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4"
             width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.1"/>
    <material name="chassis_mat"   rgba="0.75 0.1 0.1 1.0"/>
    <material name="fork_mat"      rgba="0.3 0.3 0.3 1.0"/>
    <material name="wheel_mat"     rgba="0.08 0.08 0.08 1.0"/>
    <material name="rim_mat"       rgba="0.5 0.5 0.55 1.0"/>
    <material name="seat_mat"      rgba="0.08 0.08 0.1 1.0"/>
    <material name="headlight_mat" rgba="1.0 0.95 0.7 1.0" emission="0.5"/>
    <material name="taillight_mat" rgba="0.9 0.08 0.08 1.0" emission="0.3"/>
    <material name="exhaust_mat"   rgba="0.75 0.75 0.78 1.0" specular="0.6" shininess="0.8"/>
    <material name="engine_mat"    rgba="0.25 0.25 0.28 1.0" specular="0.3"/>
    <material name="tank_mat"      rgba="0.75 0.1 0.1 1.0" specular="0.5" shininess="0.6"/>
  </asset>

  <worldbody>

    <light name="sun" pos="0 0 6" dir="0 0 -1" directional="true"
           diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <geom name="ground" type="plane" size="100 100 0.1" material="grid"
          contype="1" conaffinity="1" condim="4" friction="1.5 0.05 0.001"/>

    <!-- ============================================================
         REAR FRAME (chassis + engine + fuel tank)
         Root body. Freejoint attaches it to world.
         CoM offset backward and down from body origin to match
         real-bike mass distribution (engine low, rider position empty).
         ============================================================ -->
    <body name="rear_frame" pos="0 0 0.5">
      <freejoint name="root"/>

      <!--
        Inertial estimate for CBR500R chassis without rider:
          mass = 150 kg (frame + engine + tank w/ fuel)
          CoM approx 0.15 m forward of rear axle, 0.25 m above rear axle
            (engine is low, mass density highest at engine block)
          Ixx (roll about forward axis): dominated by lateral mass ~ 8 kg*m^2
          Iyy (pitch about lateral axis): dominated by fore-aft mass ~ 20 kg*m^2
          Izz (yaw about vertical): roughly similar to Iyy ~ 15 kg*m^2
      -->
      <!-- CoM: near wheelbase center, 0.55 m above ground (matches CBR500R real-world CoM) -->
      <inertial pos="0.0 0 0.05" mass="150" diaginertia="8.0 20.0 15.0"/>

      <!-- ============================================================
           CHASE CAMERA (v0.3)
           mode="trackcom" — camera position is a constant world-space
           offset from the parent body's subtree COM, orientation stays
           world-fixed. Gives a smooth "Steadicam" shot that follows the
           bike as it moves forward and side-to-side, without jittering
           on lean.

           To use in viewer: press [ or ] to cycle cameras, then pick
           "chase". Or the drive.py script sets it as default.
           ============================================================ -->
      <camera name="chase" mode="trackcom" pos="-4 0 1.6"
              xyaxes="0 -1 0  0.25 0 0.97"/>
      <camera name="side" mode="trackcom" pos="0 -5 1.0"
              xyaxes="1 0 0  0 0.2 0.98"/>
      <camera name="overhead" mode="trackcom" pos="0 0 12"
              xyaxes="1 0 0  0 1 0"/>

      <!-- FPV ("rider's eye") camera, frame-mounted (not steering-mounted).
           Position: ~headlight level on the chassis front. 10 deg downward
           tilt so the road and upcoming cones are both in frame.
           xyaxes convention: x=camera right (world -y), y=camera up
           (world up tilted forward by 10 deg).
           This camera IS steer-stable — it does not pan with the handlebars.
           Mirrors how comma.ai mounts their camera to the car frame. -->
      <camera name="fpv" mode="fixed" pos="0.45 0 0.3"
              xyaxes="0 -1 0  0.174 0 0.985"/>

      <!-- ============================================================
           CHASSIS COSMETIC PRIMITIVES (v0.2 cosmetic pass)
           All contype=0 conaffinity=0: pure visual, zero physics impact.
           Masses stay in <inertial> above; these geoms have no mass
           (inertiafromgeom="false" in compiler).
           ============================================================ -->

      <!-- Engine block: dark boxy mass below the tank, between the wheels -->
      <geom name="engine_vis" type="box"
            pos="-0.1 0 -0.1"
            size="0.18 0.095 0.13"
            material="engine_mat"
            contype="0" conaffinity="0"/>

      <!-- Fuel tank: rounded ellipsoid above the engine, sloping forward -->
      <geom name="tank_vis" type="ellipsoid"
            pos="0.08 0 0.08"
            size="0.22 0.11 0.09"
            material="tank_mat"
            contype="0" conaffinity="0"/>

      <!-- Rider seat: dark flat surface behind the tank -->
      <geom name="seat_vis" type="box"
            pos="-0.22 0 0.08"
            size="0.12 0.095 0.025"
            material="seat_mat"
            contype="0" conaffinity="0"/>

      <!-- Pillion / tail section rising behind the seat -->
      <geom name="tail_vis" type="box"
            pos="-0.4 0 0.06"
            size="0.08 0.07 0.05"
            material="chassis_mat"
            contype="0" conaffinity="0"/>

      <!-- Taillight: small red rectangle at the back of the tail -->
      <geom name="taillight_vis" type="box"
            pos="-0.48 0 0.06"
            size="0.015 0.05 0.025"
            material="taillight_mat"
            contype="0" conaffinity="0"/>

      <!-- Exhaust pipe: metallic capsule under the engine, exits on the right
           (negative Y in bike coords). Starts near the engine, ends near the
           swingarm pivot. -->
      <geom name="exhaust_header_vis" type="capsule"
            fromto="0.0 -0.07 -0.15  -0.25 -0.11 -0.1"
            size="0.025"
            material="exhaust_mat"
            contype="0" conaffinity="0"/>

      <!-- Muffler can: wider cylinder at the end of the header -->
      <geom name="exhaust_can_vis" type="cylinder"
            fromto="-0.25 -0.11 -0.1  -0.42 -0.13 -0.05"
            size="0.045"
            material="exhaust_mat"
            contype="0" conaffinity="0"/>

      <!-- Footpegs: two small cylinders on either side at rider-foot level -->
      <geom name="footpeg_left_vis" type="cylinder"
            fromto="-0.15 0.14 -0.08  -0.15 0.22 -0.08"
            size="0.012"
            material="fork_mat"
            contype="0" conaffinity="0"/>
      <geom name="footpeg_right_vis" type="cylinder"
            fromto="-0.15 -0.14 -0.08  -0.15 -0.22 -0.08"
            size="0.012"
            material="fork_mat"
            contype="0" conaffinity="0"/>

      <!-- ============================================================
           SWINGARM (v0.2)
           Hinges at the engine mount. Modeled with rotational spring +
           damper at the hinge, approximating the real-world monoshock
           linkage without modeling the actual shock geometry.

           Pivot placement: local (-0.305, 0, -0.188) in rear_frame coords.
           With swingarm extending backward 0.4 m and rear wheel at its
           end, the rear wheel axle sits at local (-0.705, 0, -0.188) at
           rest, matching v0.1 geometry.

           Stiffness 4000 N*m/rad gives ~5 deg sag under 874 N wheel load.
           Damping 300 N*m*s/rad is slightly overdamped for this inertia
           (no oscillation, quick settle).
           ============================================================ -->
      <body name="swingarm" pos="-0.305 0 -0.188">
        <joint name="swingarm_hinge" type="hinge" axis="0 1 0"
               stiffness="4000" damping="300" springref="0"
               range="-0.3 0.4" limited="true"/>

        <!-- Swingarm aluminum beam: ~5 kg, dominated by length-axis inertia -->
        <inertial pos="-0.2 0 0" mass="5" diaginertia="0.05 0.3 0.3"/>

        <geom name="swingarm_vis" type="cylinder"
              fromto="0 0 0  -0.4 0 0"
              size="0.025"
              material="fork_mat"
              contype="0" conaffinity="0"/>

        <!-- ============================================================
             REAR WHEEL — now child of swingarm
             Hinge about y-axis (lateral). Spins freely.
             At the swingarm end: local (-0.4, 0, 0).
             ============================================================ -->
        <body name="rear_wheel" pos="-0.4 0 0">
          <joint name="rear_spin" type="hinge" axis="0 1 0" damping="0.05"/>

          <inertial pos="0 0 0" mass="20" diaginertia="0.6 1.2 0.6"/>

          <geom name="rear_tire" type="cylinder"
                fromto="0 -0.08 0  0 0.08 0"
                size="0.312"
                material="wheel_mat"/>
        </body>
      </body>

      <!-- ============================================================
           FRONT FRAME (headstock + fork tubes + handlebars)
           Positioned at the headstock top.
           Body origin tilted backward by rake angle (25 deg) about y-axis
           so that local -z axis points down-and-forward along the fork,
           and local +z axis is the actual steer axis.

           Quaternion for -25 deg rotation about y:
             w = cos(-12.5 deg) = 0.9763
             y = sin(-12.5 deg) = -0.2164
           quat = (w, x, y, z) = (0.9763, 0, -0.2164, 0)
           ============================================================ -->
      <body name="front_frame" pos="0.55 0 0.25"
            quat="0.9763 0 -0.2164 0">

        <!-- Steer joint: hinge about body-local z axis, which is the real steer axis.
             Damping kept low so the fork can countersteer freely (real bike damper ~0.05). -->
        <joint name="steer" type="hinge" axis="0 0 1" damping="0.05"/>

        <!-- Front frame = upper fork (triple clamp + stanchions only), 6 kg.
             Half the previous "front_frame" mass; the other 6 kg moved to fork_lower. -->
        <inertial pos="0 0 -0.15" mass="6" diaginertia="0.15 0.15 0.15"/>

        <!-- Upper fork tubes: pair of stanchions (two cylinders, offset left/right) -->
        <geom name="fork_left_vis" type="cylinder"
              fromto="0 0.05 0  0 0.05 -0.3"
              size="0.022"
              material="fork_mat"
              contype="0" conaffinity="0"/>
        <geom name="fork_right_vis" type="cylinder"
              fromto="0 -0.05 0  0 -0.05 -0.3"
              size="0.022"
              material="fork_mat"
              contype="0" conaffinity="0"/>

        <!-- Triple clamp: box connecting the two fork tubes at the top -->
        <geom name="triple_clamp_vis" type="box"
              pos="0 0 0"
              size="0.03 0.085 0.015"
              material="fork_mat"
              contype="0" conaffinity="0"/>

        <!-- Handlebars: horizontal bar across the top of the triple clamp -->
        <geom name="handlebars_vis" type="capsule"
              fromto="0 -0.22 0.02  0 0.22 0.02"
              size="0.013"
              material="fork_mat"
              contype="0" conaffinity="0"/>

        <!-- Front fairing: angled ellipsoid in front of the triple clamp
             (in front_frame local coords, "forward" is +x after the rake tilt). -->
        <geom name="fairing_vis" type="ellipsoid"
              pos="0.1 0 -0.12"
              size="0.09 0.14 0.17"
              material="chassis_mat"
              contype="0" conaffinity="0"/>

        <!-- Headlight: bright yellow sphere on the fairing front -->
        <geom name="headlight_vis" type="sphere"
              pos="0.17 0 -0.1"
              size="0.055"
              material="headlight_mat"
              contype="0" conaffinity="0"/>

        <!-- Windscreen: dark sloped box above the headlight -->
        <geom name="windscreen_vis" type="box"
              pos="0.12 0 0.08"
              size="0.03 0.1 0.06"
              material="seat_mat"
              contype="0" conaffinity="0"/>

        <!-- Mirrors: two short arms extending from the handlebar ends -->
        <geom name="mirror_left_vis" type="box"
              pos="0.04 0.28 0.05"
              size="0.03 0.02 0.04"
              material="fork_mat"
              contype="0" conaffinity="0"/>
        <geom name="mirror_right_vis" type="box"
              pos="0.04 -0.28 0.05"
              size="0.03 0.02 0.04"
              material="fork_mat"
              contype="0" conaffinity="0"/>

        <!-- ============================================================
             FORK_LOWER (v0.2)
             Slides along the fork axis (local z of front_frame, which is
             the tilted steer axis in world). Compression is positive qpos.

             Slide stiffness 25000 N/m gives ~29mm sag under 715 N front
             axle load. Range 0 to 0.12 m matches real CBR500R fork travel.
             Damping 2000 N*s/m is near-critical for this spring and mass.
             ============================================================ -->
        <body name="fork_lower" pos="0 0 -0.3">
          <joint name="fork_slide" type="slide" axis="0 0 1"
                 stiffness="25000" damping="2000" springref="0"
                 range="-0.01 0.12" limited="true"/>

          <!-- Fork slider mass: ~6 kg (stanchion lowers + brake caliper mounts) -->
          <inertial pos="0 0 -0.1" mass="6" diaginertia="0.15 0.15 0.1"/>

          <!-- Fork slider tubes: pair matching the upper stanchions -->
          <geom name="fork_lower_left_vis" type="cylinder"
                fromto="0 0.05 0  0 0.05 -0.19"
                size="0.028"
                material="fork_mat"
                contype="0" conaffinity="0"/>
          <geom name="fork_lower_right_vis" type="cylinder"
                fromto="0 -0.05 0  0 -0.05 -0.19"
                size="0.028"
                material="fork_mat"
                contype="0" conaffinity="0"/>

          <!-- Front mudguard: curved cover over the top of the front tire.
               Approximated as a tilted box sitting just above the wheel. -->
          <geom name="front_mudguard_vis" type="box"
                pos="0.03 0 -0.1"
                size="0.1 0.055 0.015"
                quat="0.966 0 -0.259 0"
                material="chassis_mat"
                contype="0" conaffinity="0"/>

          <!-- ============================================================
               FRONT WHEEL — now child of fork_lower
               Positioned at the slider bottom. Still needs the inverse
               rake rotation to keep the spin axis horizontal.
               ============================================================ -->
          <body name="front_wheel" pos="0.0295 0 -0.19"
                quat="0.9763 0 0.2164 0">
            <joint name="front_spin" type="hinge" axis="0 1 0" damping="0.05"/>

            <inertial pos="0 0 0" mass="12" diaginertia="0.4 0.75 0.4"/>

            <geom name="front_tire" type="cylinder"
                  fromto="0 -0.06 0  0 0.06 0"
                  size="0.306"
                  material="wheel_mat"/>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <!-- ============================================================
       ACTUATORS (v0.3 — throttle + brake + steer, split cleanly)

       Four channels, each a direct torque motor (gear=1):

         throttle    : positive-only, rear wheel. Real engines can only
                       push forward; coasting = zero torque, not negative.
         rear_brake  : negative-only, rear wheel. ~40% of total braking
                       on a motorcycle (CBR500R rear disc).
         front_brake : negative-only, front wheel. ~60-70% of braking
                       capacity (dual front discs on CBR500R RA variant).
         steer_motor : bidirectional, steer joint. ±10 N*m matches what
                       a real rider applies to the bar.

       IMPORTANT: brakes here are naive negative-torque motors. They
       would drive a stopped wheel BACKWARD if commanded while stationary.
       The controller (drive.py) implements friction-model gating:
       only apply brake torque when the wheel is actually spinning.
       ============================================================ -->
  <actuator>
    <!-- Torque values target realistic CBR500R dynamics:
           throttle 180 Nm  -> ~0.6g peak accel (0-10 m/s in ~3s)
           rear_brake 180 Nm -> ~0.3g rear-only decel (rear brake is weaker in real life)
           front_brake 350 Nm -> ~0.6g front-only decel
           combined max 530 Nm nominal -> capped by tire friction in practice -->
    <motor name="throttle"    joint="rear_spin"  gear="1" ctrlrange="0 180"/>
    <motor name="rear_brake"  joint="rear_spin"  gear="1" ctrlrange="-180 0"/>
    <motor name="front_brake" joint="front_spin" gear="1" ctrlrange="-350 0"/>
    <!-- Position-controlled steer: ctrl is commanded steer angle (rad), not
         torque. MuJoCo auto-generates the torque needed via internal kp/kv.
         kp=500 overcomes the ~4500 N*m/rad self-centering restoring torque
         the front-end dynamics produce at speed. Previous torque-mode
         steer_motor could only apply ±10 N*m which couldn't move the fork. -->
    <position name="steer_motor" joint="steer" kp="500" kv="50" ctrlrange="-0.6 0.6"/>
  </actuator>

  <!-- ============================================================
       SENSORS
       Minimum viable observation stack for later RL / control work.
       Readable via mjData.sensordata after mj_step.
       ============================================================ -->
  <sensor>
    <framequat    name="chassis_quat"   objtype="body" objname="rear_frame"/>
    <framepos     name="chassis_pos"    objtype="body" objname="rear_frame"/>
    <framelinvel  name="chassis_linvel" objtype="body" objname="rear_frame"/>
    <frameangvel  name="chassis_angvel" objtype="body" objname="rear_frame"/>
    <jointpos     name="steer_angle"    joint="steer"/>
    <jointvel     name="steer_rate"     joint="steer"/>
    <jointvel     name="rear_wheel_rate"  joint="rear_spin"/>
    <jointvel     name="front_wheel_rate" joint="front_spin"/>
  </sensor>

</mujoco>
